// Singular SDK credentials.
//
// Copy this file to `Secrets.xcconfig` (which is gitignored) and fill in your
// own API key and secret from https://app.singular.net.
//
// These values are injected into Info.plist at build time as
// `SingularApiKey` and `SingularSecret`, then read at runtime in Constants.swift.

SINGULAR_API_KEY = your_api_key_here
SINGULAR_SECRET = your_secret_here
